#!/usr/bin/env bash

# https://en.wikipedia.org/wiki/ANSI_escape_code
 R=$'\033[0;31m'
_R=$'\033[1;4;31m'
 G=$'\033[0;32m'
_G=$'\033[1;4;32m'
 Y=$'\033[0;33m'
_Y=$'\033[1;4;33m'
 B=$'\033[0;34m'
_B=$'\033[1;4;34m'
 C=$'\033[0;36m'
_C=$'\033[1;4;36m'
 M=$'\033[0;35m'
_M=$'\033[1;4;35m'
 W=$'\033[0;37m'
_W=$'\033[1;4;37m'
RS=$'\033[0m'
BD=$'\033[1m'
